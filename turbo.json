{
  "$schema": "./node_modules/turbo/schema.json",
  "ui": "tui",
  "globalEnv": [
    "CONTACT_FROM_NAME",
    "DATABASE_URL",
    "DIRECT_URL",
    "SEO_AUDIT_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "passThroughEnv": [
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASS",
        "CONTACT_TO_EMAIL"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
